<link rel="stylesheet" href="/public/css/sections/tourism.css">

<section class="tourism-hero">
    <div class="hero-overlay">
        <div class="container text-center text-white">
            <h1>Malaysia Getaway</h1>
            <p class="hero-subtitle">3 Days 2 Nights - Valentine Edition</p>
            <p class="hero-desc">Experience Kuala Lumpur's iconic landmarks with romantic views and unforgettable moments.</p>
        </div>
    </div>
</section>

<section class="tourism-ui">
    <div class="container tourism-shell">

        <h2 class="tourism-heading">Destinations Highlights</h2>

        <div class="destinations-grid">
            <article class="destination-card">
                <img src="{{ asset('images/home.jpg') }}" alt="Petronas Twin Tower">
                <div class="destination-body">
                    <h3>Petronas Twin Tower</h3>
                    <p class="price-row">Entrance fee: <span>Rp591.000</span></p>
                    <p>Malaysia’s iconic twin towers with sweeping city skyline views and a skybridge that delivers a spectacular two-level experience.</p>
                </div>
            </article>

            <article class="destination-card">
                <img src="{{ asset('images/highlight2.png') }}" alt="KLCC Park">
                <div class="destination-body">
                    <h3>KLCC Park</h3>
                    <p class="price-row">Entrance fee: <span class="free">Rp591.000</span></p>
                    <p>Modern city park with a lush vibe, perfect for easy strolls and city views framed by the Twin Towers.</p>
                </div>
            </article>

            <article class="destination-card">
                <img src="{{ asset('images/highlight3.png') }}" alt="Lake Symphony KLCC">
                <div class="destination-body">
                    <h3>Lake Symphony KLCC</h3>
                    <p class="price-row">Entrance fee: <span class="free">Rp591.000</span></p>
                    <p>Dancing fountain show with lights and music at night, creating a romantic vibe for the Valentine edition.</p>
                </div>
            </article>

            <article class="destination-card">
                <img src="{{ asset('images/highlight4.png') }}" alt="Islamic Arts Museum Malaysia">
                <div class="destination-body">
                    <h3>Islamic Arts Museum Malaysia</h3>
                    <p class="price-row">Entrance fee: <span>Rp86.000</span></p>
                    <p>Largest Islamic art museum in Southeast Asia with architecture, manuscripts, and artifacts from many countries.</p>
                </div>
            </article>
        </div>

        <h2 class="tourism-heading itinerary-title">Itinerary Trip</h2>

        <div class="itinerary-grid">
            <article class="itinerary-card">
                <p class="day-label">Day One</p>
                <ul>
                    <li>Airport pickup at KLIA</li>
                    <li>Transfer to Kuala Lumpur hotel</li>
                    <li>Check in to 5-star hotel</li>
                    <li>Free Time in downtown Kuala Lumpur</li>
                </ul>
            </article>

            <article class="itinerary-card">
                <p class="day-label">Day Two</p>
                <ul>
                    <li>Breakfast at hotel</li>
                    <li>Islamic Arts Museum visit</li>
                    <li>Kuala Lumpur city tour (KLCC & Petronas)</li>
                    <li>Night time enjoying the Symphony Lake Water Show</li>
                </ul>
            </article>

            <article class="itinerary-card">
                <p class="day-label">Day Three</p>
                <ul>
                    <li>Breakfast at hotel</li>
                    <li>Check-out</li>
                    <li>Shopping time / optional tour</li>
                    <li>Transfer back to KLIA</li>
                </ul>
            </article>
        </div>

        <section class="include-exclude">
            <div class="include-col">
                <h3>INCLUDE</h3>
                <ul>
                    <li>Round-trip flight tickets + in-flight meals</li>
                    <li>AC coach transport to each destination</li>
                    <li>Professional driver and tour guide</li>
                    <li>5-star hotel stay + breakfast</li>
                    <li>Entrance tickets for all listed attractions</li>
                </ul>
            </div>
            <div class="exclude-col">
                <h3>EXCLUDE</h3>
                <ul>
                    <li>Lunch & dinner</li>
                    <li>Tickets for extra rides/activities</li>
                    <li>Optional tours</li>
                    <li>Hotel porter tips</li>
                    <li>Minibar, laundry, phone charges</li>
                </ul>
            </div>
        </section>

        <h2 class="tourism-heading breakdown-title">Price Breakdown</h2>

        <div class="price-table-wrap">
            <table class="price-table">
                <tbody>
                    <tr>
                        <td>Round-trip flights</td>
                        <td class="text-end amount">Rp2.300.000</td>
                        <td>Islamic Arts Museum</td>
                        <td class="text-end amount">Rp86.000</td>
                    </tr>
                    <tr>
                        <td>Hotel (3D2N)</td>
                        <td class="text-end amount">Rp2.800.000</td>
                        <td>KLCC Park</td>
                        <td class="text-end amount free">Free</td>
                    </tr>
                    <tr>
                        <td>Bus for 3 days</td>
                        <td class="text-end amount">Rp950.000</td>
                        <td>Symphony Lake Show</td>
                        <td class="text-end amount free">Free</td>
                    </tr>
                </tbody>
            </table>
            <div class="total-row">
                <span>Total Package Price:</span>
                <strong>Rp10.000.000</strong>
                <small>per person</small>
            </div>
        </div>
        
        <div class="calendar-slot">
            <img src="{{ asset('images/event calendar.png') }}" alt="Malaysia travel calendar">
        </div>
    </div>
</section>
