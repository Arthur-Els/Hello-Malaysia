<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Hello Malaysia</title>

<!-- Bootstrap -->
<link rel="stylesheet" href="/public/bootstrap/css/bootstrap.min.css">

<!-- CSS -->
<link rel="stylesheet" href="/public/css/style.css">

</head>


<body>

<!-- Navbar -->
{% include "navbar.njk" %}

<!-- Konten halaman -->
<main>
    {{ content | safe }}
</main>

    <div id="introVideoModal" class="intro-video-modal" aria-hidden="true">
        <div class="intro-video-dialog" role="dialog" aria-modal="true" aria-label="Malaysia overview video">
            <button id="introVideoPlay" class="intro-video-play" type="button">Play Intro Video</button>
            <button id="introVideoSkip" class="intro-video-skip" type="button">Skip</button>
            <video id="introVideoPlayer" class="intro-video-player" playsinline preload="metadata">
                <source src="/public/images/video AI malaysia.mp4" type="video/mp4">
                Your browser does not support HTML5 video.
            </video>
        </div>
    </div>

<!-- Footer -->
{% include "footer.njk" %}


<!-- Bootstrap JS -->
<script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- JS -->
<script src="/public/js/script.js"></script>

</body>

</html>